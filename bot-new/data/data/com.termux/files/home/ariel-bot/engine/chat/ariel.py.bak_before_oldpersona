_ARIEL_FALLBACK = "mmm... yare yare..."

# ============================================================
# MOOD — one shared mood for all of Ariel, not per-sender.
#
# Deliberately NOT a numeric score with hand-written transition
# rules (that's the same trap as hardcoding personality facts — you
# can't enumerate every input that should move a number). Instead the
# reply call itself decides, in plain text, whether anything in THIS
# turn actually warrants a mood shift, and only outputs a change when
# it does. Most turns won't change it at all — that's intentional,
# real moods have inertia.
#
# Mechanism: rather than a second Groq call (expensive, and JSON mode
# is already known to be unreliable on this model — see file header),
# the reply call appends one optional trailing line to its own plain-
# text output, e.g.:
#     ...actual reply text...
#     [[mood: annoyed]]
# That line is stripped from what actually gets sent to WhatsApp and
# only used internally to update _ARIEL_MOOD. If the tag is absent,
# mood just doesn't change this turn — the model isn't forced to
# emit one every time, so "nothing changed" costs ~nothing extra.
#
# Passive decay: if nothing has nudged her mood in a while, she drifts
# back toward baseline on her own (real time elapsed, not turn count),
# so one bad conversation hours ago can't leave her stuck sour forever
# with nobody around to talk it out.
# ============================================================

_ARIEL_BASELINE_MOOD = "content"
_ARIEL_MOOD = _ARIEL_BASELINE_MOOD
_ARIEL_MOOD_SET_AT = 0.0  # time.time() of the last real mood change
_ARIEL_MOOD_DECAY_SECONDS = 3 * 60 * 60  # drift back to baseline after ~3h untouched

_ARIEL_MOOD_TAG_RE = re.compile(r"\n?\[\[mood:\s*([a-zA-Z][a-zA-Z \-]{0,20})\]\]\s*$")


def _get_current_mood() -> str:
    """Returns Ariel's current mood, applying passive decay back to
    baseline if enough real time has passed since the last shift."""
    global _ARIEL_MOOD
    if _ARIEL_MOOD != _ARIEL_BASELINE_MOOD:
        if time.time() - _ARIEL_MOOD_SET_AT > _ARIEL_MOOD_DECAY_SECONDS:
            print(f"[ARIEL:mood] decayed back to baseline (was '{_ARIEL_MOOD}')", flush=True)
            _ARIEL_MOOD = _ARIEL_BASELINE_MOOD
    return _ARIEL_MOOD



def _apply_mood_update(new_mood: str | None) -> None:
    global _ARIEL_MOOD, _ARIEL_MOOD_SET_AT
    if not new_mood or new_mood == _ARIEL_MOOD:
        return
    print(f"[ARIEL:mood] shift: '{_ARIEL_MOOD}' -> '{new_mood}'", flush=True)
    _ARIEL_MOOD = new_mood
    _ARIEL_MOOD_SET_AT = time.time()


# ============================================================
# PER-SENDER REACTION & IMPRESSION
#
# Two more things layered on top of the one shared global mood above,
# both scoped per-sender so no two people get treated the same:
#
#   REACTION — how she's feeling toward THIS person right now (e.g.
#   annoyed at them specifically because of something they just said).
#   Same lifecycle as global mood: model-driven via an optional
#   trailing tag, decays back to neutral on its own after a stretch of
#   real time with nothing to keep it alive. In-memory, resets on
#   restart — same tier as mood/history, not meant to be durable.
#
#   IMPRESSION — a short, lasting read on WHO this person is to her
#   (e.g. "shady", "kind of funny", "clingy"). Unlike reaction, this
#   does NOT decay — it's meant to persist indefinitely once she's
#   formed one, the same way a real first impression sticks until
#   something actually changes it. Forms as early as her first
#   real read on someone (doesn't have to wait for a fixed message
#   count) and only updates when the model decides something notable
#   actually warrants revising it — most turns won't touch it at all.
#   This is what keeps two different strangers from reading as the
#   same "generic guarded Ariel" — one can come off shady, another
#   forgettable, another likeable, from the very first exchange.
# ============================================================

_ARIEL_REACTION: dict[str, str] = {}          # sender -> current reaction word/phrase
_ARIEL_REACTION_SET_AT: dict[str, float] = {}  # sender -> time.time() of last shift
_ARIEL_REACTION_DECAY_SECONDS = 60 * 60  # reactions fade faster than global mood (~1h)

_ARIEL_IMPRESSION: dict[str, str] = {}  # sender -> lasting impression phrase, no decay

_ARIEL_REACTION_TAG_RE = re.compile(r"\[\[reaction:\s*([^\]]{1,40}?)\s*\]\]")
_ARIEL_IMPRESSION_TAG_RE = re.compile(r"\[\[impression:\s*([^\]]{1,60}?)\s*\]\]")


def _get_current_reaction(sender: str) -> str | None:
    """Returns the current per-sender reaction, applying passive decay
    back to None (neutral) if enough real time has passed."""
    reaction = _ARIEL_REACTION.get(sender)
    if reaction is None:
        return None
    set_at = _ARIEL_REACTION_SET_AT.get(sender, 0.0)
    if time.time() - set_at > _ARIEL_REACTION_DECAY_SECONDS:
        print(f"[ARIEL:reaction] decayed for sender={sender} (was '{reaction}')", flush=True)
        _ARIEL_REACTION.pop(sender, None)
        _ARIEL_REACTION_SET_AT.pop(sender, None)
        return None
    return reaction


def _get_impression(sender: str) -> str | None:
    return _ARIEL_IMPRESSION.get(sender)


def _dedupe_repeats(text: str) -> str:
    """Collapses accidental immediate repeats like "no worries.no worries."
    into one copy. Only rewrites the text if a repeat was actually found."""
    parts = re.split(r"(?<=[.!?])\s*(?=[A-Za-z])", text.strip())
    out: list[str] = []
    changed = False
    for part in parts:
        key = re.sub(r"[^a-z0-9 ]", "", part.lower()).strip()
        prev = re.sub(r"[^a-z0-9 ]", "", out[-1].lower()).strip() if out else None
        if key and key == prev:
            changed = True
            continue
        out.append(part.strip())
    return " ".join(out) if changed else text


def _extract_and_strip_tags(raw_reply: str) -> tuple[str, str | None, str | None, str | None]:
    """Strips all optional trailing [[mood: ...]], [[reaction: ...]],
    and [[impression: ...]] tags off the raw model output, in any
    order/combination. Returns (clean_reply_text, new_mood_or_None,
    new_reaction_or_None, new_impression_or_None). Absence of a given
    tag just means no change for that one."""
    text = raw_reply
    new_mood = new_reaction = new_impression = None

    mood_match = _ARIEL_MOOD_TAG_RE.search(text)
    if mood_match:
        new_mood = mood_match.group(1).strip().lower() or None
        text = text[: mood_match.start()].rstrip()

    reaction_match = _ARIEL_REACTION_TAG_RE.search(text)
    if reaction_match:
        new_reaction = reaction_match.group(1).strip().lower() or None
        text = (text[: reaction_match.start()] + text[reaction_match.end():]).strip()

    impression_match = _ARIEL_IMPRESSION_TAG_RE.search(text)
    if impression_match:
        new_impression = impression_match.group(1).strip().lower() or None
        text = (text[: impression_match.start()] + text[impression_match.end():]).strip()

    return text, new_mood, new_reaction, new_impression


def _apply_reaction_update(sender: str, new_reaction: str | None) -> None:
    if not new_reaction:
        return
    if _ARIEL_REACTION.get(sender) == new_reaction:
        return
    print(f"[ARIEL:reaction] sender={sender}: '{_ARIEL_REACTION.get(sender)}' -> '{new_reaction}'", flush=True)
    _ARIEL_REACTION[sender] = new_reaction
    _ARIEL_REACTION_SET_AT[sender] = time.time()


def _apply_impression_update(sender: str, new_impression: str | None) -> None:
    if not new_impression:
        return
    if _ARIEL_IMPRESSION.get(sender) == new_impression:
        return
    print(f"[ARIEL:impression] sender={sender}: '{_ARIEL_IMPRESSION.get(sender)}' -> '{new_impression}'", flush=True)
    _ARIEL_IMPRESSION[sender] = new_impression


# ============================================================
# SENDER IDENTITY — who she thinks she's talking to.
#
# Two layers, deliberately kept separate so a WhatsApp display-name
# change never breaks the identity link:
#   1. General: whatever push_name currently shows for this sender
#      (their real WhatsApp display name, e.g. "Korii") is passed
#      through every turn so she can address them naturally and
#      notice if a familiar number renamed itself.
#   2. Special case: the King's number is matched directly against the
#      sender JID (same hardcoded-number pattern index.js already uses
#      for permission checks), independent of whatever name shows that
#      day — so even if he changes his WhatsApp name, she still knows
#      it's her brother, not two different people. The literal number
#      itself is not surfaced anywhere in her own text/voice.
# ============================================================

from config import KING_NUMBER, YUKI_NUMBER, IVY_NUMBER  # from config/identities.json (or env vars)


# ── Ariel's big sisters ───────────────────────────────────────
# For now matched by WhatsApp DISPLAY NAME (push_name), per the owner.
# Add a sister = add one entry here. Each entry:
#   key            -> stable id used internally
#   names          -> WhatsApp display names that identify her (compared
#                     case-insensitively, whitespace-collapsed)
#   numbers        -> phone numbers (digits only, no @...), read from
#                     config/identities.json (IVY_NUMBER / YUKI_NUMBER).
#                     Numbers win over names, so matching is spoof-proof.
#   call           -> what Ariel calls her
#   note           -> one line of context injected into the prompt
#
# CAVEAT: a display name is trivially spoofable (anyone can rename
# themselves "Nessa"). Harmless here — it only changes Ariel's tone —
# but once numbers are filled in they take priority over names.
ARIEL_SISTERS = {
    "ivy": {
        "names":   ["Nessa"],
        "numbers": [n for n in (IVY_NUMBER,) if n],
        "call":    "Nessa (real name Ivy), or \"onee-chan\"",
        "note":    "Ivy, who goes by Nessa on WhatsApp",
    },
    "yuki": {
        "names":   ["Yuki nosse"],
        "numbers": [n for n in (YUKI_NUMBER,) if n],
        "call":    "Yuki, or \"onee-chan\"",
        "note":    "Yuki, who goes by Yuki nosse on WhatsApp",
    },
}


def _norm_name(name: str | None) -> str:
    return re.sub(r"\s+", " ", (name or "").strip()).casefold()


def _identify_sister(sender: str, push_name: str | None) -> dict | None:
    """Returns the sister entry this sender is, or None. Numbers win over
    names when both are configured."""
    digits = (sender or "").split("@")[0]
    for entry in ARIEL_SISTERS.values():
        if digits and digits in entry["numbers"]:
            return entry
    pn = _norm_name(push_name)
    if pn:
        for entry in ARIEL_SISTERS.values():
            if pn in {_norm_name(n) for n in entry["names"]}:
                return entry
    return None


def _build_identity_context(sender: str, push_name: str | None) -> str:
    """Returns a short factual line describing who's messaging her
    right now, for injection into the system prompt. Never includes
    the raw number itself in the text she sees."""
    is_king = bool(sender) and sender.startswith(KING_NUMBER + "@")
    display = push_name.strip() if push_name and push_name.strip() else None

    if is_king and display:
        return (
            f'The person messaging you right now is saved on WhatsApp as "{display}", '
            "but you know this is actually your brother, the King — same person, "
            "whatever name he's currently using."
        )
    if is_king:
        return "The person messaging you right now is your brother, the King."

    sister = _identify_sister(sender, push_name)
    if sister:
        return (
            f"The person messaging you right now is {sister['note']} — one of your big "
            f"sisters. You call her {sister['call']}. You are genuinely, openly "
            "sweet to her: warm, affectionate, a little playful and bratty the way "
            "a younger sister is, and you drop the sarcasm and teasing edge you "
            "have with everyone else. You'd never be spiteful toward her. You're "
            "still yourself (casual, not gushy or over-the-top), you just clearly "
            "adore her."
        )

    if display:
        return f'The person messaging you right now is saved on WhatsApp as "{display}".'
    return "You don't have a saved name for whoever is messaging you right now."



def _build_rank_context(sender: str, db, group_jid: str | None) -> str:
    """One short line with this sender's rank from the .ranks system
    (bot_ranks table), the same way the hard-coded people are known.
    Empty string when they hold no rank, so it costs zero tokens for
    most people. The King is already covered by the identity block."""
    if not db or not sender or sender.startswith(KING_NUMBER + "@"):
        return ""
    try:
        rank = db.rank_for(sender, group_jid)
    except Exception as exc:
        print(f"[ARIEL:rank] lookup failed: {repr(exc)}", flush=True)
        return ""
    if not rank:
        return ""
    return (
        f"Their rank in the realm (from .ranks): {rank.title()}. It's a real title "
        "they hold. Treat it as fact and mention it only if it's relevant."
    )


# ============================================================
# CLOSENESS — how well she knows this specific person.
#
# Lifetime message count (db.closeness_bump / db.closeness_tier),
# never capped, never reset — separate from the /100 "score" system
# ariel_affection also stores (that one backs the existing .me
# command and is daily-capped; this one just tracks real cumulative
# turns and drives tone). The King is a hardcoded override: he's
# family, not someone who "earns" closeness by message count, so he's
# pinned at a starting value inside the top bracket rather than ever
# being looked up in the DB.
# ============================================================

KING_STARTING_CLOSENESS = 75  # pinned; lands in "Ride or Die", not the top tier

_CLOSENESS_TONE = {
    "Rando":          "You don't know this person. Blunt and a bit dismissive, dry, you're not going out of your way for them yet.",
    "Kinda Know You":  "You recognize them now. You'll actually engage and throw a tease or two instead of just brushing them off.",
    "Vibes":          "You're used to them. Relaxed, quick to roast them, comfortable being petty and joking around.",
    "Ride or Die":    "You trust them. You tease harder, you're more honest, and you'll give real advice without the armor.",
    "Ship Fam":       "They're inner circle. You're fully yourself with them, no front, sarcastic and warm at once.",
}


_CURRENT_PUSH_NAME: dict[str, str | None] = {}  # sender -> push_name for this turn


def _build_closeness_context(sender: str, db) -> str:
    """Returns a short line describing how close Ariel is to this
    sender, for injection into the system prompt. KING_NUMBER never
    touches the DB for this — he's always pinned."""
    is_king = bool(sender) and sender.startswith(KING_NUMBER + "@")
    if is_king:
        tier, _ = _closeness_tier_from_count(KING_STARTING_CLOSENESS)
        return f"How close you are to them: {tier}. {_CLOSENESS_TONE[tier]}"
    # Sisters are family — pinned high, not earned by message count.
    # Needs push_name to identify by display name, so it's stashed by
    # ariel_chat() just before this runs (see _CURRENT_PUSH_NAME).
    if _identify_sister(sender, _CURRENT_PUSH_NAME.get(sender)):
        tier, _ = _closeness_tier_from_count(KING_STARTING_CLOSENESS)
        return f"How close you are to them: {tier}. {_CLOSENESS_TONE[tier]}"

    if not db:
        tier = "Rando"
    else:
        try:
            tier, _ = db.closeness_tier(sender)
        except Exception as exc:
            print(f"[ARIEL:closeness] tier lookup failed: {repr(exc)}", flush=True)
            tier = "Rando"

    return f"How close you are to them: {tier}. {_CLOSENESS_TONE.get(tier, _CLOSENESS_TONE['Rando'])}"


def _closeness_tier_from_count(count: int) -> tuple[str, int]:
    """Same bracket logic as Database._CLOSENESS_TIERS, duplicated
    here so the King's pinned value can resolve to a tier name without
    a DB round-trip."""
    for threshold, name in (
        (100, "Ship Fam"),
        (61,  "Ride or Die"),
        (31,  "Vibes"),
        (16,  "Kinda Know You"),
        (0,   "Rando"),
    ):
        if count >= threshold:
            return name, count
    return "Rando", count


def _bump_closeness(sender: str, db) -> None:
    """Increments lifetime talk count for this sender, skipped for the
    King since his closeness is pinned, not earned."""
    if not db or (sender or "").startswith(KING_NUMBER + "@"):
        return
    if _identify_sister(sender, _CURRENT_PUSH_NAME.get(sender)):
        return
    try:
        db.closeness_bump(sender)
    except Exception as exc:
        print(f"[ARIEL:closeness] bump failed: {repr(exc)}", flush=True)



# Per-sender short conversation memory. In-memory only (resets on
# restart) — this is just recent chat context for the reply call, not
# anything durable.
#
# Keyed differently depending on context:
#   - DM (group_jid is None): keyed by sender, exactly as before —
#     each person's history with Ariel stays their own.
#   - Group (group_jid set): keyed by group_jid instead, SHARED across
#     everyone talking to her in that group. Doesn't merge people's
#     identities — each user turn is prefixed with the speaker's name
#     ("Ivy: hyd") so she can still tell who said what — but it means
#     she now sees the actual back-and-forth between multiple people
#     replying to her in the same thread, instead of each person
#     looking like the only one talking. Her own replies are stored
#     once per turn either way, not duplicated per speaker.
_ARIEL_MEMORY: dict[str, list[dict]] = {}
_ARIEL_MAX_TURNS = 8


def _history_key(sender: str, group_jid: str | None) -> str:
    return f"group:{group_jid}" if group_jid else sender


# Side-channel for the sticker Ariel chose on the most recent reply,
# per sender. ariel_chat() still returns a plain string (so the one
# existing caller in router/handle.py doesn't need to change its
# return-value handling) — callers that want the sticker choice call
# pop_ariel_sticker(sender) right after, which also clears it so a
# stale choice can't leak into an unrelated later message.
_ARIEL_LAST_STICKER: dict[str, str] = {}


def pop_ariel_sticker(sender: str) -> str | None:
    """Returns and clears the sticker tag (or None) from the most
    recent ariel_chat() call for this sender."""
    return _ARIEL_LAST_STICKER.pop(sender, None)


def _get_history(sender: str, group_jid: str | None = None) -> list[dict]:
    return _ARIEL_MEMORY.setdefault(_history_key(sender, group_jid), [])


def _speaker_label(push_name: str | None, sender: str) -> str:
    name = (push_name or "").strip()
    return name if name else "Someone"


def _update_history(sender: str, user_message: str, reply: str,
                     group_jid: str | None = None, push_name: str | None = None) -> None:
    history = _get_history(sender, group_jid)
    stored_user_line = (
        f"{_speaker_label(push_name, sender)}: {user_message}" if group_jid else user_message
    )
    history.append({"role": "user", "content": stored_user_line})
    history.append({"role": "assistant", "content": reply})
    if len(history) > _ARIEL_MAX_TURNS * 2:
        del history[: len(history) - _ARIEL_MAX_TURNS * 2]


_MENTION_TOKEN_RE = re.compile(r"@(\d{5,20})")


def _resolve_mention_name(jid: str, db, group_jid: str | None) -> str | None:
    """Looks up a saved WhatsApp display name for a mentioned JID via
    the existing group-name cache (db.get_group_names). Returns None
    if there's no db/group context or no cached name yet — callers
    fall back to a neutral placeholder rather than ever surfacing the
    raw number."""
    if not db or not group_jid:
        return None
    try:
        known = db.get_group_names(group_jid)
    except Exception as exc:
        print(f"[ARIEL:identity] get_group_names failed: {repr(exc)}", flush=True)
        return None
    for entry in known:
        if entry.get("sender") == jid:
            name = entry.get("push_name")
            return name.strip() if name and name.strip() else None
    return None


def _scrub_mentions_from_text(message: str, mentioned_jid: str | None,
                               db, group_jid: str | None) -> str:
    """Replaces WhatsApp's literal '@<number>' mention token(s) in the
    raw message text with a resolved name (or a neutral placeholder),
    so Ariel never sees a raw phone number in what she reads — same
    principle as _build_identity_context, just for a third person
    mentioned mid-message rather than the sender themselves.

    mentioned_jid (already resolved upstream in index.js/router) is
    used to resolve the name once; every @<number> token found in the
    text is swapped for that same resolved value, since WhatsApp
    clients only ever surface one real @mention per message in the
    flows this bot handles.
    """
    if "@" not in message:
        return message

    resolved_name = None
    if mentioned_jid:
        resolved_name = _resolve_mention_name(mentioned_jid, db, group_jid)
    replacement = resolved_name if resolved_name else "someone whose name isn't saved"

    def _sub(match: "re.Match") -> str:
        return replacement

    return _MENTION_TOKEN_RE.sub(_sub, message)


def ariel_chat(sender: str, message: str, push_name: str | None = None, db=None,
                group_jid: str | None = None, mentioned_jid: str | None = None) -> str:
    """Ariel's main chat entry point, called from router/handle.py.

    mentioned_jid identifies a tagged/quoted third person, if any —
    used only to scrub WhatsApp's raw @<number> mention token out of
    the text before it ever reaches the model (see
    _scrub_mentions_from_text). db/group_jid back that same lookup
    (existing group-name cache) and are otherwise still unused here.
    """
    key = os.environ.get("GROQ_API_KEY", "").strip()
    if not key:
        return _ARIEL_FALLBACK

    message = _scrub_mentions_from_text(message, mentioned_jid, db, group_jid)

    try:
        from groq import Groq
        client = Groq(api_key=key)
    except Exception as exc:
        print(f"[ARIEL] Groq client init failed: {repr(exc)}", flush=True)
        _ARIEL_LAST_STICKER.pop(sender, None)
        return _ARIEL_FALLBACK

    _CURRENT_PUSH_NAME[sender] = push_name
    _bump_closeness(sender, db)

    history = _get_history(sender, group_jid)
    current_mood = _get_current_mood()
    group_note = (
        "This is a group chat — more than one person talks to you here. "
        'Earlier lines are labeled "Name: message" so you know who said what. '
        "Reply to whoever's message you're actually responding to, and address "
        "different people differently if it's relevant — don't treat everyone "
        "as the same person just because it's one thread."
        if group_jid else
        "This is a one-on-one chat — just you and this person."
    )
    current_reaction = _get_current_reaction(sender)
    current_impression = _get_impression(sender)
    reaction_line = (
        f"Right now, specifically toward this person, you're feeling: {current_reaction}."
        if current_reaction else
        "You don't have any particular reaction toward this person right now beyond your overall mood."
    )
    impression_line = (
        f"Your lasting read on who this person is: {current_impression}."
        if current_impression else
        "You haven't formed a real read on this person yet — this may be your chance to."
    )
    system_prompt = _ARIEL_SYSTEM_TEMPLATE.format(
        mood=current_mood,
        identity=(_build_identity_context(sender, push_name)
                  + ("\n" + _rank_line if (_rank_line := _build_rank_context(sender, db, group_jid)) else "")),
        closeness=_build_closeness_context(sender, db),
        group_note=group_note,
        reaction_line=reaction_line,
        impression_line=impression_line,
    )
    messages = [{"role": "system", "content": system_prompt}]
    for turn in history:
        messages.append({"role": turn["role"], "content": turn["content"]})
    current_line = f"{_speaker_label(push_name, sender)}: {message}" if group_jid else message
    messages.append({"role": "user", "content": current_line})

    def _do_completion(model: str):
        resp = client.chat.completions.create(
            model=model,
            messages=messages,
            temperature=0.9,
            # Reasoning model: this budget is shared with hidden reasoning
            # tokens, so it needs headroom for the longer replies (advice,
            # roasts) the personality now allows, not just the visible text.
            max_completion_tokens=900,
        )
        text = (resp.choices[0].message.content or "").strip()
        usage = getattr(resp, "usage", None)
        if usage is not None:
            cached = 0
            details = getattr(usage, "prompt_tokens_details", None)
            if details is not None:
                cached = getattr(details, "cached_tokens", 0) or 0
            prompt_tokens = getattr(usage, "prompt_tokens", 0) or 0
            hit_rate = f"{(cached / prompt_tokens * 100):.0f}%" if prompt_tokens else "n/a"
            print(
                f"[ARIEL] token usage (sender={sender}, model={model}): "
                f"prompt={prompt_tokens} "
                f"completion={getattr(usage, 'completion_tokens', '?')} "
                f"cached={cached} (hit rate {hit_rate})",
                flush=True,
            )
        return text

    try:
        raw_reply = _do_completion(GROQ_MODEL)
    except Exception as exc:
        status = getattr(exc, "status_code", None)
        if status == 429:
            # Rate limited on the primary reply model — fall back once
            # to GROQ_STICKER_MODEL (separate bucket) rather than
            # immediately giving up. Only one fallback attempt: if
            # that's also limited, both buckets are genuinely full and
            # retrying further just burns time on a dead request.
            print(f"[ARIEL] rate limited (429) on {GROQ_MODEL}, "
                  f"falling back to {GROQ_STICKER_MODEL}", flush=True)
            try:
                raw_reply = _do_completion(GROQ_STICKER_MODEL)
            except Exception as exc2:
                status2 = getattr(exc2, "status_code", None)
                if status2 == 429:
                    print(f"[ARIEL] also rate limited (429) on "
                          f"{GROQ_STICKER_MODEL}, giving up", flush=True)
                else:
                    print(f"[ARIEL] fallback Groq error: {repr(exc2)}", flush=True)
                _ARIEL_LAST_STICKER.pop(sender, None)
                return _ARIEL_FALLBACK
        else:
            print(f"[ARIEL] Groq error: {repr(exc)}", flush=True)
            _ARIEL_LAST_STICKER.pop(sender, None)
            return _ARIEL_FALLBACK

    if not raw_reply:
        _ARIEL_LAST_STICKER.pop(sender, None)
        return _ARIEL_FALLBACK

    reply, new_mood, new_reaction, new_impression = _extract_and_strip_tags(raw_reply)
    reply = _dedupe_repeats(reply)
    _apply_mood_update(new_mood)
    _apply_reaction_update(sender, new_reaction)
    _apply_impression_update(sender, new_impression)

    if not reply:
        # Defensive: only happens if the model emitted nothing but a
        # mood tag, which shouldn't happen per the prompt, but don't
        # send an empty WhatsApp message if it somehow does.
        _ARIEL_LAST_STICKER.pop(sender, None)
        return _ARIEL_FALLBACK

    _update_history(sender, message, reply, group_jid=group_jid, push_name=push_name)

    sticker_manifest = _load_sticker_manifest()
    sticker = _pick_sticker(client, reply, message, sticker_manifest)
    if sticker:
        _ARIEL_LAST_STICKER[sender] = sticker
        print(f"[ARIEL:sticker] stored for sender={sender}: '{sticker}'", flush=True)
    else:
        _ARIEL_LAST_STICKER.pop(sender, None)

    return reply
