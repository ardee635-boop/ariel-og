# ============================================================
# ARIEL.PY — NIFLHEIM
# Ariel — plain chat companion. Runs on Groq (openai/gpt-oss-120b).
#
# REBUILT: plain-text reply (no response_format/JSON mode) instead
# of asking one call to produce reply+remember+sticker as strict
# JSON. That JSON requirement was fragile on this model (gpt-oss-120b
# is a reasoning model; forcing strict JSON output on top of hidden
# reasoning tokens caused frequent "Failed to generate JSON" 400s).
# Pattern borrowed from an older, plain-text npc.py that ran
# reliably — same idea (plain text reply, small token budget), kept
# on the current model since the old model it used is now
# deprecated on Groq.
#
# Two Groq calls per message:
#   1. Reply call — plain text, no JSON, this is Ariel's actual voice.
#   2. Sticker call — tiny, separate, cheap: given the reply + the
#      sticker manifest, picks a tag or NONE. Isolated so a messy
#      pick never breaks the reply itself.
#
# Dropped for this first pass (add back later if wanted): persistent
# "remember" memory, the people block, push_name lookup. Short-term
# in-process conversation history is kept (resets on restart).
#
# Requires GROQ_API_KEY in the environment.
# ============================================================

import os
import re
import time
import json as _json
import requests

GROQ_MODEL = "openai/gpt-oss-20b"
# Sticker pick uses a different model than the reply — deliberately
# separate rate-limit bucket from GROQ_MODEL, since the reply call
# was hitting its limit fast with both calls stacked on 20b.
GROQ_STICKER_MODEL = "openai/gpt-oss-120b"
# Sticker pick runs on a separate model from the reply — same request
# volume, but a different bucket means it doesn't stack onto the 20b
# rate limit that the actual reply call depends on.
GROQ_STICKER_MODEL = "openai/gpt-oss-120b"

# Ariel's sticker vocabulary is entirely dynamic — built via the .take
# command in index.js, which uploads both the .webp file and an entry
# in manifest.json to Supabase Storage (bucket "ariel-stickers", object
# "ariel/manifest.json"). Render's local disk is ephemeral and wiped on
# every deploy, so this is NOT read off the filesystem — it's fetched
# over HTTP from the same public bucket URL index.js writes to, so
# Python and Node stay in sync without a local file or bridge call.
_ARIEL_STICKERS_BUCKET = "ariel-stickers"
_ARIEL_STICKERS_PREFIX = "ariel"
_ARIEL_MANIFEST_OBJECT = f"{_ARIEL_STICKERS_PREFIX}/manifest.json"


def _ariel_stickers_public_url(object_path: str) -> str:
    supabase_url = os.environ.get("SUPABASE_URL", "").rstrip("/")
    return f"{supabase_url}/storage/v1/object/public/{_ARIEL_STICKERS_BUCKET}/{object_path}"


# ============================================================
# STICKERS — rebuilt from scratch
#
# Every step below logs what actually happened, on purpose. The
# previous version failed 100% of the time in production with no
# visible reason why, because every failure path was silent
# (bare `except: return {}` / `return None`). We traced the real
# root cause separately: index.js's callPython() destructured a
# `sticker` field that bridge.py did send correctly, but the send
# block reading it never actually got exercised because ariel.py's
# _pick_sticker() was returning None on every call — undiagnosable
# from logs because nothing said why. This version can't fail silently.
# ============================================================

def _load_sticker_manifest() -> dict:
    """Returns {tag: description} for every sticker saved via .take.
    Fetched from Supabase Storage (same bucket/object index.js writes
    to) rather than local disk. Empty dict if none saved yet, or if
    the bucket object doesn't exist yet — both normal states. Every
    outcome is logged so a live run tells us directly which case
    we're in, instead of us guessing from an empty log."""
    supabase_url = os.environ.get("SUPABASE_URL", "")
    if not supabase_url:
        print("[ARIEL:sticker] SUPABASE_URL not set — cannot load manifest", flush=True)
        return {}

    url = _ariel_stickers_public_url(_ARIEL_MANIFEST_OBJECT)
    try:
        resp = requests.get(url, timeout=10)
    except requests.RequestException as exc:
        print(f"[ARIEL:sticker] manifest fetch error: {repr(exc)}", flush=True)
        return {}

    if resp.status_code in (404, 400):
        print("[ARIEL:sticker] manifest not found in bucket — treating as empty", flush=True)
        return {}

    if not resp.ok:
        print(f"[ARIEL:sticker] manifest fetch failed: {resp.status_code}", flush=True)
        return {}

    try:
        data = resp.json()
    except ValueError as exc:
        print(f"[ARIEL:sticker] manifest failed to parse ({exc}); raw={resp.text!r}", flush=True)
        return {}

    if not isinstance(data, dict):
        print(f"[ARIEL:sticker] manifest is not a JSON object (got {type(data).__name__}): {data!r}", flush=True)
        return {}

    manifest = {str(k): str(v or "") for k, v in data.items()}
    print(f"[ARIEL:sticker] manifest loaded: {len(manifest)} tag(s) -> {sorted(manifest.keys())}", flush=True)
    return manifest


ARIEL_FALLBACK_TAG = "ariel"


def _pick_sticker(client, reply: str, user_message: str, manifest: dict) -> str | None:
    """Separate, cheap call: given the reply about to be sent, choose
    which saved sticker fits best. Ariel sends one on every turn (as
    long as her manifest isn't completely empty). No descriptions
    anymore — she matches on tag name alone. If the model can't
    confidently match a real tag, this falls back to the reserved
    "ariel" tag (a hardcoded catch-all pack the owner maintains) rather
    than guessing randomly among unrelated tags. Isolated from the
    reply call so a bad pick can never block or break the actual text
    reply. Every branch logs its outcome — no silent None returns
    except the true empty-manifest case."""
    if not manifest:
        print("[ARIEL:sticker] skip: manifest is empty", flush=True)
        return None

    options = "\n".join(f"- {tag}" for tag in manifest)
    prompt = (
        "Given Ariel's reply below, pick whichever tag name best matches "
        "its mood or content. She sends a sticker with every reply. If "
        f'none of them clearly fit, answer with "{ARIEL_FALLBACK_TAG}" '
        "instead. Answer with ONLY the tag name — no other words.\n\n"
        f"Her available stickers (tag names only):\n{options}\n\n"
        f'Ariel is about to reply: "{reply}"\n'
        f'(replying to: "{user_message}")'
    )

    try:
        resp = client.chat.completions.create(
            model=GROQ_STICKER_MODEL,
            messages=[{"role": "user", "content": prompt}],
            max_completion_tokens=400,
            temperature=0,
        )
        raw_pick = (resp.choices[0].message.content or "").strip()
        usage = getattr(resp, "usage", None)
        if usage is not None:
            print(
                f"[ARIEL:sticker] token usage: "
                f"prompt={getattr(usage, 'prompt_tokens', '?')} "
                f"completion={getattr(usage, 'completion_tokens', '?')}",
                flush=True,
            )
    except Exception as exc:
        print(f"[ARIEL:sticker] pick call failed: {repr(exc)}; falling back to '{ARIEL_FALLBACK_TAG}'", flush=True)
        return ARIEL_FALLBACK_TAG

    pick = raw_pick.strip(" \"'`.\n").strip()
    print(f"[ARIEL:sticker] model returned: {raw_pick!r} -> cleaned: {pick!r}", flush=True)

    if pick not in manifest:
        print(
            f"[ARIEL:sticker] decision: '{pick}' is not a known tag — "
            f"falling back to '{ARIEL_FALLBACK_TAG}'",
            flush=True,
        )
        return ARIEL_FALLBACK_TAG

    print(f"[ARIEL:sticker] decision: '{pick}'", flush=True)
    return pick


